{
  "openapi": "3.1.1",
  "info": {
    "title": "AWG-Forge node control API",
    "version": "0.1.0-draft",
    "description": "Internal controller/node contract. Public CA bootstrap, enrollment claim/status, mTLS presence and certificate renewal are implemented on explicitly enabled listeners. Non-loopback exposure additionally requires exact endpoint consent and a verified retained encrypted backup. Snapshots are implemented; operation routes remain proposed; this draft is not a public operator API.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://controller.example",
      "description": "Dedicated AWG-Forge control listener"
    }
  ],
  "security": [
    {
      "nodeMTLS": []
    }
  ],
  "tags": [
    {
      "name": "Enrollment",
      "description": "Short-lived bootstrap before a node certificate exists."
    },
    {
      "name": "Node",
      "description": "Authenticated node presence and redacted observations."
    },
    {
      "name": "Operations",
      "description": "Bounded long-poll delivery and durable idempotent receipts."
    },
    {
      "name": "Certificates",
      "description": "Node-generated CSR renewal over the existing mTLS identity."
    }
  ],
  "paths": {
    "/control/v1/bootstrap": {
      "get": {
        "operationId": "getEnrollmentBootstrap",
        "summary": "Read public controller CA for pinned bootstrap",
        "description": "Secret-free and registry-free public CA discovery. Treat the response as untrusted: verify the exact existing CA SPKI sha256 pin, self-signed CA constraints and validity, then repeat over normally verified TLS1.3 chain/SAN/time before sending any enrollment secret. No proxy, redirect, query, Authorization or request body. Subject to existing bootstrap limits.",
        "tags": [
          "Enrollment"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Public CA only; no invitation expiry, registry, credentials or management data.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentBootstrap"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitedProblem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/control/v1/enrollments/{invitation_id}/claim": {
      "post": {
        "operationId": "claimEnrollmentInvitation",
        "summary": "Claim a one-time enrollment invitation",
        "description": "The node verifies the controller CA/SPKI pin before sending this request. The invitation secret is supplied as a bearer value and must never appear in the URL, command arguments, environment, logs, or durable plaintext storage.",
        "tags": ["Enrollment"],
        "security": [
          {
            "enrollmentSecret": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentClaimRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The CSR is bound to the invitation and awaits explicit controller approval.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentClaimAccepted"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "410": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/control/v1/enrollments/{enrollment_id}": {
      "get": {
        "operationId": "getEnrollmentStatus",
        "summary": "Read enrollment approval status",
        "description": "An exact CSR retry returns the same claim capability until expiry; a competing CSR returns 409. The claim token is returned only by the successful claim response and is stored as a digest by the controller. An approved response contains the node certificate but never a private key. Public CA bootstrap, claim/status, presence and renewal are implemented on explicitly enabled endpoints; snapshot and operation routes remain draft.",
        "tags": ["Enrollment"],
        "security": [
          {
            "claimToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EnrollmentID"
          }
        ],
        "responses": {
          "200": {
            "description": "Current enrollment state.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentStatus"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "410": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/control/v1/node/presence": {
      "put": {
        "operationId": "putNodePresence",
        "summary": "Publish authenticated node presence",
        "description": "Node identity comes from the verified client certificate. A node identifier supplied by a proxy header or request body is never authoritative. Invalid boot/state/binding authority returns 409 presence_fenced; temporary registry failure returns 503 control_unavailable and permits bounded retry.",
        "tags": ["Node"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodePresence"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presence accepted and polling guidance returned.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresenceAccepted"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/control/v1/node/snapshot": {
      "put": {
        "operationId": "putNodeSnapshot",
        "summary": "Publish a redacted node snapshot",
        "description": "The snapshot is an allowlisted observation from the authoritative node state. A newer desired_generation refreshes the controller's desired-state projection; a same-generation snapshot may refresh runtime observations when its snapshot_sequence is newer for the active boot_id. The controller never overwrites node state from its cache. The snapshot never contains private keys, preshared keys, full configs, QR or vpn:// payloads, WARP credentials, environment values, or raw command output. Implemented: validates current certificate, session, boot/state/binding fences and monotonic generation/sequence in one transaction. Collection budget 5 seconds, upload timeout 15 seconds, retry backoff with jitter capped at 30 seconds. Observations include runtime counters and a bounded runtime Doctor summary, not full local Doctor output.",
        "tags": [
          "Node"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeSnapshot"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitedProblem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          },
          "200": {
            "description": "Snapshot accepted; max body 512 KiB, 64 tunnels, 2048 total clients. One projection per identity, at most 1024 projections. Same generation must preserve exact desired metadata; a newer sequence refreshes observations only.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/control/v1/node/operations/poll": {
      "post": {
        "operationId": "pollNodeOperation",
        "summary": "Wait for one typed operation",
        "description": "At most one poll is active for a node. The controller returns one complete operation or 204 after the bounded wait. Delivery is at least once and the node executes idempotently using its durable receipt.",
        "tags": ["Operations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationPollRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One operation is leased to the node.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationDelivery"
                }
              }
            }
          },
          "204": {
            "description": "No operation became available before the bounded wait elapsed.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/control/v1/node/operations/{operation_id}/result": {
      "put": {
        "operationId": "putNodeOperationResult",
        "summary": "Publish a durable operation result",
        "description": "Replaying the same terminal receipt is idempotent. A conflicting terminal result is rejected. Secret client artifacts use a separate ephemeral channel and are never embedded here.",
        "tags": ["Operations"],
        "parameters": [
          {
            "$ref": "#/components/parameters/OperationID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationReceipt"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Terminal result stored or an identical result replay acknowledged.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/control/v1/node/certificate-renewals": {
      "post": {
        "operationId": "node.certificate-renewal",
        "summary": "Renew the current node certificate",
        "description": "Requires the presented verified mTLS certificate and current registry binding. The body current_serial must match that peer certificate; boot_id is informational and does not establish identity. A signed extension-free Ed25519 CSR with a different key may renew at or after two thirds of the predecessor's actual validity interval. One predecessor gets one successor. An exact full-CSR retry from that predecessor returns the committed certificate only while the predecessor remains authorized; a different CSR conflicts. The predecessor overlap ends no later than 24 hours after commit or its own expiry, and revocation can end it earlier.",
        "tags": ["Certificates"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateRenewalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The committed replacement certificate, or the identical certificate from an authorized exact retry.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedCertificate"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimitedProblem" },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "nodeMTLS": {
        "type": "mutualTLS",
        "description": "AWG-Forge-managed node certificate verified by the dedicated control listener and checked against active node and binding state."
      },
      "enrollmentSecret": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque one-time invitation secret",
        "description": "High-entropy single-use enrollment secret entered interactively and accepted only with a verified controller CA/SPKI pin."
      },
      "claimToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque enrollment claim token",
        "description": "Short-lived token returned after the controller atomically binds an invitation to one CSR. Only its digest is stored."
      }
    },
    "parameters": {
      "InvitationID": {
        "name": "invitation_id",
        "in": "path",
        "required": true,
        "description": "Non-secret identifier included in the controller-generated command.",
        "schema": { "$ref": "#/components/schemas/UUID" }
      },
      "EnrollmentID": {
        "name": "enrollment_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UUID" }
      },
      "OperationID": {
        "name": "operation_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UUID" }
      }
    },
    "headers": {
      "NoStore": {
        "description": "Control responses are never cacheable.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "RequestID": {
        "description": "Safe correlation identifier for logs and audit events.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "RetryAfter": {
        "description": "Seconds before retrying a rate-limited request.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe RFC 9457 problem response without internal error details.",
        "headers": {
          "Cache-Control": { "$ref": "#/components/headers/NoStore" },
          "X-Request-ID": { "$ref": "#/components/headers/RequestID" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "RateLimitedProblem": {
        "description": "The request exceeded a bounded enrollment, node, or global limit.",
        "headers": {
          "Cache-Control": { "$ref": "#/components/headers/NoStore" },
          "X-Request-ID": { "$ref": "#/components/headers/RequestID" },
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "schemas": {
      "EnrollmentBootstrap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ca_cert_pem"
        ],
        "properties": {
          "ca_cert_pem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      },
      "UUID": {
        "type": "string",
        "format": "uuid"
      },
      "BootID": {
        "allOf": [
          { "$ref": "#/components/schemas/UUID" }
        ],
        "description": "Random identity generated on every application process start."
      },
      "Epoch": {
        "allOf": [
          { "$ref": "#/components/schemas/UUID" }
        ],
        "description": "Random identity epoch used to fence restored, reset, or cloned state."
      },
      "Capabilities": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 64
        }
      },
      "EnrollmentClaimRequest": {
        "type": "object",
        "required": ["requested_name", "csr_pem", "boot_id", "application_version", "contract_versions", "capabilities"],
        "properties": {
          "requested_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "csr_pem": {
            "type": "string",
            "minLength": 128,
            "maxLength": 8192,
            "writeOnly": true,
            "description": "PEM PKCS#10 CSR. The corresponding private key never leaves the node."
          },
          "boot_id": { "$ref": "#/components/schemas/BootID" },
          "application_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "contract_versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          },
          "capabilities": { "$ref": "#/components/schemas/Capabilities" }
        },
        "additionalProperties": false
      },
      "EnrollmentClaimAccepted": {
        "type": "object",
        "required": ["enrollment_id", "claim_token", "verification_code", "expires_at", "poll_after_seconds"],
        "properties": {
          "enrollment_id": { "$ref": "#/components/schemas/UUID" },
          "claim_token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 256,
            "readOnly": true,
            "description": "Short-lived opaque token. The controller stores only a keyed digest."
          },
          "verification_code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4}-[A-Z0-9]{4}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "poll_after_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "additionalProperties": false
      },
      "EnrollmentStatus": {
        "type": "object",
        "oneOf": [
          { "$ref": "#/components/schemas/EnrollmentPending" },
          { "$ref": "#/components/schemas/EnrollmentApproved" },
          { "$ref": "#/components/schemas/EnrollmentRejected" },
          { "$ref": "#/components/schemas/EnrollmentExpired" }
        ],
        "discriminator": {
          "propertyName": "status"
        }
      },
      "EnrollmentPending": {
        "type": "object",
        "required": ["status", "verification_code", "expires_at", "poll_after_seconds"],
        "properties": {
          "status": { "type": "string", "const": "pending" },
          "verification_code": { "type": "string", "pattern": "^[A-Z0-9]{4}-[A-Z0-9]{4}$" },
          "expires_at": { "type": "string", "format": "date-time" },
          "poll_after_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "EnrollmentApproved": {
        "type": "object",
        "required": ["status", "node_id", "controller_id", "binding_epoch", "certificate", "contract_version"],
        "properties": {
          "status": { "type": "string", "const": "approved" },
          "node_id": { "$ref": "#/components/schemas/UUID" },
          "controller_id": { "$ref": "#/components/schemas/UUID" },
          "binding_epoch": { "type": "integer", "minimum": 1 },
          "certificate": { "$ref": "#/components/schemas/IssuedCertificate" },
          "contract_version": { "type": "integer", "const": 1 }
        },
        "additionalProperties": false
      },
      "EnrollmentRejected": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "const": "rejected" }
        },
        "additionalProperties": false
      },
      "EnrollmentExpired": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "const": "expired" }
        },
        "additionalProperties": false
      },
      "NodePresence": {
        "type": "object",
        "required": ["boot_id", "boot_sequence", "application_version", "contract_version", "state_epoch", "binding_epoch", "desired_generation", "capabilities", "observed_at"],
        "properties": {
          "boot_id": { "$ref": "#/components/schemas/BootID" },
          "boot_sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Persisted monotonic process-start sequence within one state_epoch. The controller accepts a replacement session only from a greater sequence; the same sequence may renew only the matching boot_id."
          },
          "application_version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "contract_version": { "type": "integer", "const": 1 },
          "state_epoch": { "$ref": "#/components/schemas/Epoch" },
          "binding_epoch": { "type": "integer", "minimum": 1 },
          "desired_generation": { "type": "integer", "minimum": 0 },
          "capabilities": { "$ref": "#/components/schemas/Capabilities" },
          "observed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "PresenceAccepted": {
        "type": "object",
        "required": ["controller_id", "session_id", "session_expires_at", "server_time", "next_poll_seconds", "renew_certificate_after"],
        "properties": {
          "controller_id": { "$ref": "#/components/schemas/UUID" },
          "session_id": {
            "allOf": [
              { "$ref": "#/components/schemas/UUID" }
            ],
            "description": "Controller-issued node session bound to the authenticated certificate, boot_id, boot_sequence, state_epoch, and binding_epoch."
          },
          "session_expires_at": { "type": "string", "format": "date-time" },
          "server_time": { "type": "string", "format": "date-time" },
          "next_poll_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
          "renew_certificate_after": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "NodeSnapshot": {
        "type": "object",
        "required": [
          "contract_version",
          "session_id",
          "boot_id",
          "boot_sequence",
          "snapshot_sequence",
          "state_epoch",
          "binding_epoch",
          "desired_generation",
          "observed_at",
          "desired",
          "observations"
        ],
        "properties": {
          "contract_version": {
            "type": "integer",
            "const": 1
          },
          "session_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "boot_id": {
            "$ref": "#/components/schemas/BootID"
          },
          "boot_sequence": {
