{
  "scripts": {
    "api:contract": "redocly lint --config redocly.yaml && node scripts/check-openapi-contract.mjs",
    "ui:dev": "vite --host 127.0.0.1 --port 51923 --config web/vite.config.ts",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:check": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/tsconfig.tests.json",
    "ui:lint": "deno lint web/src web/tests playwright.config.ts",
    "ui:test": "npm run ui:build && playwright test",
    "quality:aislop": "aislop ci"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "^2.10.2",
    "@redocly/cli": "2.51.2",
    "@types/node": "24.13.3",
    "aislop": "^0.16.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "preact": "^10.26.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
