+func Test_splitCoalescedMessagesPreservesPacketInfo(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		source  string
+		groSize int
+		want    int
+	}{
+		{name: "single IPv4 packet", source: "192.0.2.66", want: 1},
+		{name: "coalesced IPv4 packets", source: "192.0.2.66", groSize: 1, want: 2},
+		{name: "coalesced IPv6 packets", source: "2001:db8::66", groSize: 1, want: 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			source := netip.MustParseAddr(tc.source)
+			endpoint := new(StdNetEndpoint)
+			setSrc(endpoint, source, 5)
+			messages := make([]ipv6.Message, 3)
+			for i := range messages {
+				messages[i].Buffers = net.Buffers{make([]byte, 2)}
+				messages[i].OOB = make([]byte, stickyControlSize)
+			}
+			const batchStart = 2
+			messages[batchStart].N = 2
+			messages[batchStart].NN = copy(messages[batchStart].OOB, endpoint.src)
+			n, err := splitCoalescedMessages(messages, batchStart, func([]byte) (int, error) {
+				return tc.groSize, nil
+			})
+			if err != nil || n != tc.want {
+				t.Fatalf("split produced (%d, %v), want (%d, nil)", n, err, tc.want)
+			}
+			for i, message := range messages[:n] {
+				got := new(StdNetEndpoint)
+				getSrcFromControl(message.OOB[:message.NN], got)
+				if got.SrcIP() != source || got.SrcIfidx() != 5 {
+					t.Errorf("packet %d: got source %v ifindex %d, want %v ifindex 5", i, got.SrcIP(), got.SrcIfidx(), source)
+				}
+			}
+		})
+	}
+}
